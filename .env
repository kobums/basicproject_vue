# 프론트엔드가 호출할 API 베이스 URL. dev 에서는 vite 프록시(/api → VITE_PROXY_TARGET)를 탄다.
# 백엔드를 직접 가리키려면 .env.local 에서 VITE_API_BASE_URL=http://localhost:8007/api 처럼 override.
VITE_API_BASE_URL=/api

# dev 서버 프록시 대상 (vite.config.ts). Go :8007 (기본) / Spring :8081 / Rust :8080
VITE_PROXY_TARGET=http://localhost:8007
